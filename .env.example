# =============================================================================
# api_agenda — porte Spring Boot do azzo-agenda-pro (Quarkus)
# =============================================================================
# Copie para .env e ajuste. O .env é gitignored; ESTE arquivo é versionado —
# nunca coloque segredo real aqui.
#
# Os nomes de variável foram preservados 1:1 em relação ao Quarkus original
# (backend/azzo-agenda-pro/.env.example) de propósito, para facilitar migrar
# a configuração de um projeto para o outro.
#
# Convenções:
#   __set_in_prod__ / __change_me__  → você DEVE substituir
#   __unset__                        → sentinela que o código entende como "não configurado"
#
# Só as variáveis abaixo costumam precisar de ajuste. application*.yml tem
# ~90 outras com default seguro (timeouts, tamanhos de lote, cron de expurgo,
# endpoints de NFS-e etc.) — sobrescreva apenas se souber o motivo.
# =============================================================================

SPRING_PROFILES_ACTIVE=prod

# ─── OBRIGATÓRIAS ────────────────────────────────────────────────────────────
# Sem estas o boot falha (sem default em application.yml).

# Chave de criptografia de dados sensíveis (tokens de WhatsApp/Telegram, certificados).
# DEVE ser a MESMA do azzo-assistant-api, senão um não decifra o que o outro gravou.
ENCRYPTION_KEY=__change_me_32_bytes_min__

# Par de chaves RSA do JWT (formato PEM). Gere com:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=__set_in_prod__
JWT_PUBLIC_KEY=__set_in_prod__

# ─── Banco de dados ──────────────────────────────────────────────────────────
# DB_NAME só é usado pelo docker-compose.yml (monta POSTGRES_DB e a DB_URL do
# serviço api_agenda). Para rodar fora do Compose, ajuste DB_URL diretamente.
DB_NAME=azzo
DB_URL=jdbc:postgresql://localhost:5432/azzo?currentSchema=azzo_app
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ─── URL pública do backend ──────────────────────────────────────────────────
# Usada para montar e REGISTRAR o webhook do Telegram (setWebhook).
# ⚠️ O Telegram EXIGE HTTPS — http:// é rejeitado.
APP_PUBLIC_BASE_URL=https://localhost:8443

# Prefixo de rota da API atrás do proxy. Em produção a API responde em /agenda.
ROOT_PATH_AGENDA=/

# ─── CORS ────────────────────────────────────────────────────────────────────
# Em produção NÃO use wildcard (*). Liste os domínios explicitamente.
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,http://127.0.0.1:5173,https://127.0.0.1:5173

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=STRICT
AUTH_COOKIE_DOMAIN=__unset__
MFA_ISSUER=Azzo Agenda Pro

# ─── Integração com o assistente de IA ───────────────────────────────────────
# INTERNAL_API_KEY deve ser IDÊNTICA à do azzo-assistant-api.
ASSISTANT_API_URL=http://localhost:8081
INTERNAL_API_KEY=__change_me_internal_api_key__
ASSISTANT_API_CONNECT_TIMEOUT=5000
ASSISTANT_API_READ_TIMEOUT=15000

# ─── WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
# META_APP_SECRET valida a assinatura HMAC do webhook e é fail-closed em produção.
META_APP_SECRET=__set_in_prod__
META_APP_ID=__unset__
META_GRAPH_API_VERSION=v18.0
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false

# ─── Agendamento público ─────────────────────────────────────────────────────
PUBLIC_BOOKING_BASE_URL=http://localhost:5173

# ─── E-mail (SMTP) ───────────────────────────────────────────────────────────
MAIL_CREDENTIALS_ENABLED=true
# true = em falha de SMTP, imprime a credencial no console (NUNCA use em produção).
MAIL_CREDENTIALS_CONSOLE_FALLBACK_ENABLED=false
MAIL_CREDENTIALS_USERNAME=__set_in_prod__
MAIL_CREDENTIALS_PASSWORD=__set_in_prod__
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_STARTTLS=REQUIRED
MAIL_SSL=false
MAIL_FROM=no-reply@azzoholding.com.br
MAIL_SMTP_AUTH_MECHANISMS=LOGIN PLAIN

# ─── LGPD ────────────────────────────────────────────────────────────────────
# Só LGPD_CONTACT_EMAIL é bloqueante, e apenas em produção.
LGPD_CONTACT_EMAIL=privacidade@azzoholding.com.br
LGPD_CONTACT_CHANNEL=Canal de privacidade oficial
LGPD_CONTACT_RESPONSE_SLA=confirmacao ate 2 dias uteis; resposta inicial ate 15 dias corridos; conclusao ate 30 dias corridos

# ─── Pagamentos (Asaas) ──────────────────────────────────────────────────────
# Com ASAAS_ENABLED=false o módulo fica inerte e as chaves são ignoradas.
ASAAS_ENABLED=false
ASAAS_API_KEY=__unset__
ASAAS_WEBHOOK_TOKEN=__unset__
ASAAS_BASE_URL=https://sandbox.asaas.com

# ─── Armazenamento de arquivos (MinIO) ───────────────────────────────────────
# Usado em importações (CSV) e uploads (logo de salão, DANFE, PDF de NFS-e).
# Com MINIO_ENABLED=false nada é exigido.
MINIO_ENABLED=false
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=azzo-importacoes
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=__change_me__

# ─── Fiscal / NFS-e ──────────────────────────────────────────────────────────
# FISCAL_PROVIDER=mock não emite nada de verdade — seguro para dev.
FISCAL_PROVIDER=mock
FISCAL_PROVIDER_BASE_URL=__unset__
NFSE_TEST_PROVIDERS_ENABLED=true

# ─── Retenção de chat (dias) ─────────────────────────────────────────────────
CHAT_RETENTION_DAYS_DEFAULT=5
CHAT_RETENTION_DAYS_COMPLETED=1
CHAT_RETENTION_DAYS_CANCELED=2

# ─── Servidor ────────────────────────────────────────────────────────────────
SERVER_PORT=8080
